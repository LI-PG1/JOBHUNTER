  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "mammoth": "^1.8.0",
    "onnxruntime-node": "^1.27.0",
    "pdfjs-dist": "^6.2.108"
  },
  "allowScripts": {
    "onnxruntime-node@1.27.0": true
  }
}
