# JobHunter 求职工作台 配置（复制为 .env）
# API Key 也可以在界面「控制台 → API Key」中配置并自动同步（用户自带 Key，不服务端托管）

# 大模型配置（OpenAI 兼容接口）：key 由控制台 API Key 管理自动同步，勿手改
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_PROVIDER=deepseek

# 运行模式：mock（本地全流程模拟，无需 Key）/ real（真实 LLM，仅需上面的 Key）
# JOBHUNTER 单仓库自包含：能力全部来自进程内三组件 + 本地 tracker，不依赖任何外部服务
RUN_MODE=mock
